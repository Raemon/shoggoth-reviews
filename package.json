{
  "name": "humanintheloop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "reposcope": "bin/reposcope.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 2111",
    "build": "npm run check:caching && next build",
    "start": "next start --port 2111",
    "typecheck": "tsc --noEmit",
    "check:caching": "node scripts/checkGithubCaching.mjs",
    "predev": "node scripts/copyTreeSitterWasm.mjs",
    "prebuild": "node scripts/copyTreeSitterWasm.mjs",
    "check:folds": "tsx scripts/checkFolds.mjs",
    "check:previews": "tsx scripts/checkPreviews.mjs",
    "desktop": "node bin/reposcope.mjs --dev",
    "check:local-git": "tsx scripts/checkLocalGit.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "marked": "^18.0.11",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "3.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "44.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
